{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for Lantern workspace and remote-control windows",
  "windows": ["main", "remote-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-fullscreen",
    "opener:default"
  ]
}
